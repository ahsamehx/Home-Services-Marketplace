{
  "info": {
    "name": "Home Services Marketplace - Full",
    "description": "Comprehensive API collection for testing user, catalog, booking, requests and notification flows",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "User Service (8080)",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"customer1\",\n  \"password\": \"pass123\",\n  \"userType\": \"CUSTOMER\"\n}" },
            "url": { "raw": "http://localhost:8080/api/users/register", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api","users","register"] }
          }
        },
        {
          "name": "Login",
          "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"username\": \"customer1\",\n  \"password\": \"pass123\"\n}" }, "url": { "raw": "http://localhost:8080/api/users/login", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api","users","login"] } }
        },
        {
          "name": "Get User By ID",
          "request": { "method": "GET", "url": { "raw": "http://localhost:8080/api/users/1", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api","users","1"] } }
        },
        {
          "name": "Get Users By Type",
          "request": { "method": "GET", "url": { "raw": "http://localhost:8080/api/users/type/CUSTOMER", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api","users","type","CUSTOMER"] } }
        },
        {
          "name": "Get All Users (admin)",
          "request": { "method": "GET", "url": { "raw": "http://localhost:8080/api/users?adminId=1", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api","users"], "query": [ { "key": "adminId", "value": "1" } ] } }
        }
      ]
    },
    {
