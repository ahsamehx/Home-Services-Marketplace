          "request": { "method": "GET", "url": { "raw": "http://localhost:8080/api/wallet/1", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api","wallet","1"] } }
        },
        {
          "name": "Validate Balance",
          "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"userId\": 1,\n  \"amount\": 100.00\n}" }, "url": { "raw": "http://localhost:8080/api/wallet/validate", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api","wallet","validate"] } }
        },
        {
          "name": "Hold Amount",
          "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"userId\": 1,\n  \"amount\": 100.00,\n  \"bookingId\": 1\n}" }, "url": { "raw": "http://localhost:8080/api/wallet/hold", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api","wallet","hold"] } }
        },
        {
          "name": "Confirm Deduction",
          "request": { "method": "POST", "url": { "raw": "http://localhost:8080/api/wallet/confirm", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api","wallet","confirm"] } }
        },
        {
          "name": "Rollback Deduction",
          "request": { "method": "POST", "url": { "raw": "http://localhost:8080/api/wallet/rollback", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api","wallet","rollback"] } }
        }
      ]
    },
