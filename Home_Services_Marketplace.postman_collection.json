          "name": "Get Offers By Provider",
          "request": { "method": "GET", "url": { "raw": "http://localhost:8081/api/offers/provider/2", "protocol": "http", "host": ["localhost"], "port": "8081", "path": ["api","offers","provider","2"] } }
