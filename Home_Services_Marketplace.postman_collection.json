          "name": "Get Booking History",
          "request": { "method": "GET", "url": { "raw": "http://localhost:8082/api/bookings/1/history", "protocol": "http", "host": ["localhost"], "port": "8082", "path": ["api","bookings","1","history"] } }
        },
        {
          "name": "Confirm Booking",
          "request": { "method": "POST", "url": { "raw": "http://localhost:8082/api/bookings/1/confirm", "protocol": "http", "host": ["localhost"], "port": "8082", "path": ["api","bookings","1","confirm"] } }
