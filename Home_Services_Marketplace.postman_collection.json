      "item": [
        {
          "name": "Add Funds",
          "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"userId\": 1,\n  \"amount\": 500.00\n}" }, "url": { "raw": "http://localhost:8080/api/wallet/add-funds", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api","wallet","add-funds"] } }
        },
        {
