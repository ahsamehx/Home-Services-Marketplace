          "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"customerId\": 1,\n  \"offerId\": 1,\n  \"serviceProviderId\": 2,\n  \"serviceDate\": \"2026-06-15\"\n}" }, "url": { "raw": "http://localhost:8082/api/bookings", "protocol": "http", "host": ["localhost"], "port": "8082", "path": ["api","bookings"] } }
